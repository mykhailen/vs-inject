{
  "name": "vs-inject",
  "version": "0.1.0",
  "description": "Minimal typed dependency-injection container for TypeScript: tokens as parameter decorators, lazy singletons, circular-dependency detection. Zero dependencies.",
  "keywords": [
    "dependency-injection",
    "di",
    "ioc",
    "inversion-of-control",
    "container",
    "typescript",
    "decorators"
  ],
  "license": "MIT",
  "author": "Evgen Mykhailenko",
  "repository": {
    "type": "git",
    "url": "https://github.com/mykhailen/vs-inject.git"
  },
  "bugs": {
    "url": "https://github.com/mykhailen/vs-inject/issues"
  },
  "homepage": "https://github.com/mykhailen/vs-inject#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "pretest": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\"",
    "test": "tsc -p tsconfig.test.json && node --test out/test/container.test.js",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run check-types && npm run build && npm test && npm run smoke"
  },
  "devDependencies": {
    "@types/node": "22.x",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
